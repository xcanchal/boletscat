NODE_ENV=development
PORT=8080
PREDICTION_DIR=private/predictions
DATABASE_URL=postgresql://boletada:boletada_local@localhost:5432/boletada
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Google OAuth (callback local: http://localhost:8080/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correu transaccional (API compatible amb Resend)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Boletada <hola@boletada.cat>
EMAIL_PROVIDER_URL=https://api.resend.com/emails
REQUIRE_EMAIL_VERIFICATION=false

# RevenueCat (s'activaran a la fase de billing)
REVENUECAT_SECRET_API_KEY=
REVENUECAT_API_URL=https://api.revenuecat.com/v1
REVENUECAT_ENTITLEMENT_ID=boletada_pro
REVENUECAT_WEB_PUBLIC_API_KEY=
