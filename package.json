{
  "name": "boletscat",
  "version": "1.0.0",
  "private": true,
  "description": "Predictor de bolets per Catalunya, web i app Capacitor.",
  "scripts": {
    "dev": "npm run prepare:public && node --watch src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test",
    "prepare:public": "node scripts/prepare-public.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "email:send": "node scripts/emails/send-email.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "build:mobile": "node build-mobile.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:open:ios": "npm run cap:sync && npx cap open ios",
    "cap:open:android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@hono/node-server": "^2.1.1",
    "@revenuecat/purchases-js": "^1.53.1",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "maplibre-gl": "4.7.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0"
  }
}
